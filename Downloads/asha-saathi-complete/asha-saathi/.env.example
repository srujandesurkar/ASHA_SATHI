# ================================================================
# ASHA Saathi - Environment Configuration
# ================================================================
# Note: For production and hackathon judging with live Gnani APIs,
# provide your Gnani Prisma & Timbre credentials below.
# If left empty, ASHA Saathi runs in clearly labeled Demo Mode.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Gnani Voice AI Credentials
GNANI_API_KEY=
GNANI_TOKEN=
GNANI_PRISMA_WS_URL=wss://api.gnani.ai/v1/prisma/stream
GNANI_TIMBRE_TTS_URL=https://api.gnani.ai/v1/timbre/synthesize

# Language & Code-Mix Configuration
DEFAULT_LANGUAGE=hi-IN-codemix
SUPPORTED_LANGUAGES=["hi-IN-codemix", "en-IN", "ta-IN-codemix", "te-IN-codemix", "mr-IN-codemix"]

# Storage & Database (SQLite Synthetic Data)
DATABASE_URL=sqlite+aiosqlite:///./asha_saathi.db

# Security & Responsible AI
DISCLOSE_AI_IDENTITY=true
SESSION_ENCRYPTION_KEY=asha-saathi-synthetic-dev-key-32chars
RETAIN_AUDIO=false
ENCRYPT_TRANSCRIPTS=true
